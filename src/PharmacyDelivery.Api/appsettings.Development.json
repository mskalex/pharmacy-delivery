{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=pharmacy_delivery;Username=pharmacy_delivery;Password=pharmacy-delivery-test-only",
    "Redis": "localhost:6379"
  },
  "Database": {
    "EnableSensitiveDataLogging": true
  },
  "RabbitMq": {
    "Password": "pharmacy-delivery-test-only"
  },
  "Auth": {
    "Jwt": {
      "AllowEphemeralSigningKey": true
    }
  },
  "Payments": {
    "Provider": "Fake",
    "WebhookSecret": "dev-only-webhook-secret-change-me",
    "FakeWebhookBaseUrl": "http://localhost:5080"
  },
  "Seed": {
    "Mode": "IfEmpty",
    "Profile": "demo",
    "AllowReset": true,
    "UsersPassword": "Demo-Password-2026!"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "SamplingRatio": 1.0
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Security": {
    "UseHsts": false
  },
  "ErrorHandling": {
    "IncludeExceptionDetails": true
  },
  "Admin": {
    "MaintenanceEndpointsEnabled": true
  },
  "NLog": {
    "rules": {
      "2": { "writeTo": "textConsole" },
      "4": { "writeTo": "textConsole" },
      "6": { "writeTo": "textConsole" },
      "7": { "minLevel": "Debug", "writeTo": "textConsole,file" }
    }
  }
}
