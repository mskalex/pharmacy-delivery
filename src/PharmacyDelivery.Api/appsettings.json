{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 30,
    "LockTimeoutMs": 2000,
    "StatementTimeoutMs": 30000,
    "SlowQueryThresholdMs": 500,
    "EnableSensitiveDataLogging": false
  },
  "Redis": {
    "KeyPrefix": "pharmacy-delivery:"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "pharmacy_delivery",
    "Password": "",
    "ManagementUrl": "http://localhost:15672"
  },
  "Auth": {
    "Mode": "Local",
    "Issuer": "pharmacy-delivery-api",
    "Audience": "pharmacy-delivery",
    "AccessTokenMinutes": 15,
    "CustomerRefreshTokenDays": 14,
    "CourierRefreshTokenDays": 30,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "TokenRetentionDays": 7,
    "Password": {
      "MinLength": 12,
      "MaxLength": 128,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequireDigit": false,
      "RequireNonAlphanumeric": false,
      "HistoryCount": 5,
      "MaxAgeDays": 0
    },
    "Jwt": {
      "SigningKeyPem": "",
      "SigningKeyPath": "",
      "KeyId": "pharmacy-delivery-es256-1",
      "AllowEphemeralSigningKey": false
    },
    "Oidc": {
      "Authority": "",
      "Audience": "",
      "RoleClaim": "role",
      "RequireHttpsMetadata": true
    }
  },
  "Checkout": {
    "DeliveryRadiusKm": 5,
    "MaxPharmacyAttempts": 3,
    "ReservationTtlMinutes": 15,
    "MaxCartItems": 30,
    "MaxQuantityPerItem": 10,
    "CartTtlHours": 24,
    "TimeZone": "America/New_York"
  },
  "Pharmacy": {
    "AcceptanceTimeoutMinutes": 3,
    "MinutesPerQueuedOrder": 2,
    "BasePreparationMinutes": 5
  },
  "Dispatch": {
    "SearchRadiusKm": 7,
    "MaxCandidates": 10,
    "MaxPositionAgeSeconds": 120,
    "CourierLockSeconds": 15
  },
  "Tracking": {
    "MaxBatchSize": 50,
    "MaxSpeedKmh": 120,
    "MaxPointAgeMinutes": 10,
    "PushIntervalMs": 1000,
    "EtaRecalcSeconds": 30,
    "ChannelCapacity": 10000,
    "HistoryBatchSize": 500,
    "HistoryFlushIntervalMs": 1000,
    "HistoryRetentionDays": 30,
    "PartitionsAheadDays": 7
  },
  "Eta": {
    "AverageSpeedKmh": 25,
    "RoadFactor": 1.3,
    "MaxConcurrentRequests": 8
  },
  "Payments": {
    "Provider": "Stripe",
    "WebhookSecret": "",
    "SignatureToleranceSeconds": 300,
    "FakeWebhookBaseUrl": "http://localhost:8080"
  },
  "Seed": {
    "Mode": "None",
    "Profile": "demo",
    "AllowReset": false,
    "PurgeQueuesOnReset": false,
    "UsersPassword": "",
    "AdminPassword": ""
  },
  "Jobs": {
    "ReservationExpiry": { "Enabled": true, "IntervalSeconds": 30, "BatchSize": 100 },
    "AcceptanceTimeout": { "Enabled": true, "IntervalSeconds": 20, "BatchSize": 50 },
    "DispatchRetry": { "Enabled": true, "IntervalSeconds": 15, "BatchSize": 50 },
    "PartitionMaintenance": { "Enabled": true, "IntervalSeconds": 3600, "BatchSize": 1 },
    "RetentionCleanup": { "Enabled": true, "IntervalSeconds": 3600, "BatchSize": 5000 },
    "StockSync": { "Enabled": true, "IntervalSeconds": 600, "BatchSize": 4 }
  },
  "Audit": {
    "Enabled": true,
    "MaskedProperties": [ "PasswordHash", "TokenHash" ],
    "RetentionDays": 365
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "pharmacy-delivery-api",
    "OtlpEndpoint": "",
    "OtlpProtocol": "grpc",
    "SamplingRatio": 0.1,
    "ExportLogs": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "UseHsts": true,
    "TrustAllForwardedHeaders": false
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Checkout": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Tracking": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "ErrorHandling": {
    "IncludeExceptionDetails": false
  },
  "Admin": {
    "MaintenanceEndpointsEnabled": false
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "MassTransit": "Warning"
    }
  },
  "StartupReport": {
    "Enabled": true,
    "IncludeEnvironmentVariables": true
  },
  "NLog": {
    "throwConfigExceptions": true,
    "internalLogLevel": "Warn",
    "targets": {
      "async": true,
      "console": {
        "type": "Console",
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            { "name": "time", "layout": "${date:universalTime=true:format=o}" },
            { "name": "level", "layout": "${level:upperCase=true}" },
            { "name": "logger", "layout": "${logger}" },
            { "name": "message", "layout": "${mask-pii:inner=${message}}" },
            { "name": "exception", "layout": "${mask-pii:inner=${exception:format=tostring}}" },
            { "name": "traceId", "layout": "${trace-id}" },
            { "name": "spanId", "layout": "${span-id}" },
            { "name": "version", "layout": "${app-version}" },
            { "name": "environment", "layout": "${app-environment}" }
          ]
        }
      },
      "textConsole": {
        "type": "ColoredConsole",
        "layout": "${date:format=HH\\:mm\\:ss.fff} ${level:upperCase=true:padding=-5} ${logger:shortName=true} ${mask-pii:inner=${message}} ${exception:format=tostring} [${trace-id}]"
      },
      "file": {
        "type": "File",
        "fileName": "${basedir}/logs/${shortdate}/${level:lowercase=true}.log",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 10,
        "layout": "${date:universalTime=true:format=o}|${level:upperCase=true}|${logger}|${trace-id}|${app-version}|${mask-pii:inner=${message}}|${mask-pii:inner=${exception:format=tostring}}"
      }
    },
    "rules": [
      { "logger": "Microsoft.EntityFrameworkCore.Database.Command", "final": true },
      { "logger": "Microsoft.AspNetCore.DataProtection.*", "maxLevel": "Warn", "final": true },
      { "logger": "Microsoft.Hosting.Lifetime", "minLevel": "Info", "writeTo": "console", "final": true },
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "Microsoft.*", "writeTo": "console", "final": true },
      { "logger": "System.*", "maxLevel": "Info", "final": true },
      { "logger": "System.*", "writeTo": "console", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "console,file" }
    ]
  }
}
