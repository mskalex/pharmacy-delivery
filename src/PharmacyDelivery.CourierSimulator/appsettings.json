    ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http": "Warning",
      "Microsoft": "Warning"
    }
  },
  "NLog": {
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${date:universalTime=true:format=o} ${level:upperCase=true} ${logger:shortName=true} ${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      { "logger": "System.Net.Http.*", "maxLevel": "Info", "final": true },
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "console" }
    ]
  }
}
