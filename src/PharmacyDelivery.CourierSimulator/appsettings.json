{
  "Simulator": {
    "ApiBaseUrl": "http://localhost:5080",
    "Password": "",
    "IntervalSeconds": 2,
    "SpeedKmh": 90,
    "IdleReportSeconds": 20,
    "Couriers": [
      { "Email": "courier1@pharmacy-delivery.local", "Latitude": 40.7490, "Longitude": -73.9900 },
      { "Email": "courier2@pharmacy-delivery.local", "Latitude": 40.7240, "Longitude": -73.9970 },
      { "Email": "courier3@pharmacy-delivery.local", "Latitude": 40.7460, "Longitude": -74.0040 },
      { "Email": "courier4@pharmacy-delivery.local", "Latitude": 40.7190, "Longitude": -73.9600 },
      { "Email": "courier5@pharmacy-delivery.local", "Latitude": 40.7050, "Longitude": -74.0120 },
