# Staging: the same image as Test, configuration only through environment variables / secrets.
# Secrets come from the deployment's secret store (GitLab CI/CD variables, Kubernetes secrets) — never from this file.
ASPNETCORE_ENVIRONMENT=Staging
ConnectionStrings__Postgres=Host=<staging-postgres>;Port=5432;Database=pharmacy_delivery;Username=pharmacy_delivery;Password=<secret>
ConnectionStrings__Redis=<staging-redis>:6379,password=<secret>,ssl=true
RabbitMq__Host=<staging-rabbitmq>
RabbitMq__Password=<secret>
Auth__Jwt__SigningKeyPath=/run/secrets/jwt-signing-key.pem
Payments__Provider=Stripe
Payments__WebhookSecret=<secret>
Seed__Mode=IfEmpty
Seed__Profile=empty
Seed__AdminPassword=<secret>
OpenTelemetry__OtlpEndpoint=http://<otel-collector>:4317
