# Test stand (docker compose). Copy to env/test.env (git-ignored) and run:
#   docker compose --env-file env/test.env up -d --build
# Every variable is optional: without it docker-compose.yml uses a TEST-ONLY default. Descriptions: docs/configuration.md.
ASPNETCORE_ENVIRONMENT=Test
APP_VERSION=0.1.0-local

POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
PSP_WEBHOOK_SECRET=
SEED_USERS_PASSWORD=

# IfEmpty | Reset | None ; demo | empty | large
SEED_MODE=IfEmpty
SEED_PROFILE=demo

# Host ports
API_PORT=5080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
ASPIRE_UI_PORT=18888
OTLP_GRPC_PORT=4317
