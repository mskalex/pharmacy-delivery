# Production: no seed, no maintenance endpoints, a real PSP. Startup fails on dangerous combinations
# (fake PSP, missing JWT key, Seed:AllowReset) — see docs/configuration.md "Environments".
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Postgres=Host=<prod-postgres>;Port=5432;Database=pharmacy_delivery;Username=pharmacy_delivery;Password=<secret>
ConnectionStrings__Redis=<prod-redis>:6379,password=<secret>,ssl=true
RabbitMq__Host=<prod-rabbitmq>
RabbitMq__Password=<secret>
Auth__Jwt__SigningKeyPath=/run/secrets/jwt-signing-key.pem
Payments__Provider=Stripe
Payments__WebhookSecret=<secret>
Seed__Mode=None
OpenTelemetry__OtlpEndpoint=http://<otel-collector>:4317
OpenTelemetry__SamplingRatio=0.1
